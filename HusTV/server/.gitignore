# .gitignore for HusTV Backend (Node.js + Express + MongoDB)

# ========================================
# Environment Variables (CRITICAL - NEVER COMMIT)
# ========================================
.env
.env.local
.env.development
.env.test
.env.production
.env.*.local

# ========================================
# Dependencies
# ========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# ========================================
# Temporary Files & Uploads
# ========================================
temp/
temp/*
temp/uploads/
temp/uploads/*
uploads/
*.tmp
*.temp

# ========================================
# Logs
# ========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

# ========================================
# Operating System Files
# ========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.Trash-*

# ========================================
# IDE & Editor Files
# ========================================
# VSCode
.vscode/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# WebStorm / IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
.idea_modules/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock

# ========================================
# Build Output
# ========================================
dist/
build/
out/
.next/
.nuxt/
.cache/

# ========================================
# Testing
# ========================================
coverage/
.nyc_output/
*.lcov
.jest/

# ========================================
# Database
# ========================================
# MongoDB local data
data/
mongodb/
*.db

# SQLite
*.sqlite
*.sqlite3

# ========================================
# Cloudinary & Media Files (optional - nếu test local)
# ========================================
# Uncomment nếu bạn download videos về local để test
# videos/
# images/
# media/

# ========================================
# Vercel
# ========================================
.vercel
.vercel/*

# ========================================
# Stripe
# ========================================
# Stripe CLI local config
.stripe/

# ========================================
# Package Manager
# ========================================
# Yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# pnpm
.pnpm-debug.log*

# ========================================
# Miscellaneous
# ========================================
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# ========================================
# Optional Files (Uncomment if needed)
# ========================================
# Ignore all video files in uploads
# *.mp4
# *.mov
# *.avi
# *.mkv
# *.webm

# Ignore all image files
# *.jpg
# *.jpeg
# *.png
# *.gif
# *.webp

# ========================================
# Custom Project Files
# ========================================
# Add any project-specific files here
test-env.js